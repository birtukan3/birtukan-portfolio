path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg> info@smartoffice.com</li><li class="jsx-e6a322de0b29adb9 flex items-center gap-3 text-slate-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin h-5 w-5" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg> New York, NY 10001</li><li class="jsx-e6a322de0b29adb9 flex items-center gap-3 text-slate-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock h-5 w-5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg> 24/7 Support</li></ul></div><div class="jsx-e6a322de0b29adb9"><h4 class="jsx-e6a322de0b29adb9 font-semibold text-lg mb-4">Newsletter</h4><p class="jsx-e6a322de0b29adb9 text-slate-400 text-sm mb-3">Get the latest updates and offers</p><div class="jsx-e6a322de0b29adb9 flex"><input placeholder="Your email" class="jsx-e6a322de0b29adb9 flex-1 px-4 py-2.5 bg-slate-800 rounded-l-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" type="email" value=""><button class="jsx-e6a322de0b29adb9 px-5 py-2.5 bg-gradient-to-r from-indigo-600 to-purple-600 rounded-r-lg hover:from-indigo-700 hover:to-purple-700 transition">Subscribe</button></div></div></div><div class="jsx-e6a322de0b29adb9 border-t border-slate-800 mt-12 pt-8 text-center text-slate-400 text-sm"><p class="jsx-e6a322de0b29adb9">© 2026 SmartOffice. All rights reserved. | Made with <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="